# MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/secure_task_manager?createDatabaseIfNotExist=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

# JWT (generate with: openssl rand -base64 32)
APPLICATION_SECURITY_JWT_SECRET_KEY=replace-with-base64-secret
APPLICATION_SECURITY_JWT_EXPIRATION=86400000

# CORS
APPLICATION_CORS_ALLOWED_ORIGINS=http://localhost:3000